{
  "manifest_version": 3,
  "name": "Timer for Browser",
  "version": "1.5.0",
  "description": "持久统计指定网站每日前台停留时间，每日 0:00 自动清零",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background_wrapper.js",
    "scripts": ["background_wrapper.js"]
  },
  "action": {
    "default_title": "网站停留时间",
    "default_popup": "popup.html",
    "default_icon": "icons/timer.svg"
  },
  "icons": {
    "48": "icons/timer.svg"
  }
}
