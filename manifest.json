{
  "manifest_version": 2,
  "name": "Timer for Browser",
  "version": "1.2.0",
  "description": "持久统计指定网站每日前台停留时间，每日 0:00 自动清零",
  "applications": {
    "gecko": {
      "id": "timer-for-browser@nowadays.local",
      "strict_min_version": "91.0"
    }
  },
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "https://gemini.google.com/*",
    "https://*.zhihu.com/*",
    "https://zhihu.com/*",
    "https://*.xiaohongshu.com/*",
    "https://xiaohongshu.com/*",
    "https://*.douyin.com/*",
    "https://douyin.com/*",
    "https://*.bilibili.com/*",
    "https://bilibili.com/*"
  ],
  "background": {
    "scripts": ["sites.js", "storage.js", "background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_title": "网站停留时间",
    "default_popup": "popup.html",
    "default_icon": "icons/timer.svg"
  },
  "icons": {
    "48": "icons/timer.svg"
  }
}
